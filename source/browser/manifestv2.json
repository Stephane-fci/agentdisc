{
    "manifest_version": 2,
    "minimum_chrome_version": "91",

    "name": "AgentDisc",
    "description": "Discord in the browser, set up for working with agents: typing dots on threads, panel switches and themes. Built on Vencord (GPL-3.0).",
    "author": "Stephane Franceschini, built on Vencord by Vendicated",
    "homepage_url": "https://github.com/Vendicated/Vencord",
    "icons": {
        "128": "icon.png"
    },

    "permissions": [
        "webRequest",
        "webRequestBlocking",
        "*://*.discord.com/*",
        "https://raw.githubusercontent.com/*"
    ],

    "content_scripts": [
        {
            "run_at": "document_start",
            "matches": ["*://*.discord.com/*"],
            "exclude_matches": ["*://*.discord.com/developers*"],
            "js": ["content.js"],
            "all_frames": true,
            "world": "ISOLATED"
        },
        {
            "run_at": "document_start",
            "matches": ["*://*.discord.com/*"],
            "exclude_matches": ["*://*.discord.com/developers*"],
            "js": ["dist/Vencord.js"],
            "all_frames": true,
            "world": "MAIN"
        }
    ],

    "background": {
        "scripts": ["background.js"]
    },

    "web_accessible_resources": ["dist/Vencord.js", "dist/Vencord.css"],

    "browser_specific_settings": {
        "gecko": {
            "id": "vencord-firefox@vendicated.dev",
            "strict_min_version": "128.0"
        }
    }
}
